# Copy to .env and fill in. .env is gitignored — never commit it.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/fastcat

# --- LLM gateway (institutional AWS Bedrock proxy) -------------------------
# Base URL of the Bedrock invoke gateway and its API key.
HUIT_API_BASE_URL=https://your-gateway.example.edu/bedrock/v2
HUIT_API_KEY=

# --- metadata sources (all optional; pipeline degrades gracefully) ---------
# Google Books: free key, raises the shared rate limit to your own quota.
# https://console.cloud.google.com/apis/credentials (enable "Books API")
GOOGLE_BOOKS_API_KEY=

# Tavily web search: enables the last-resort metadata rung for books missing
# from library databases. Free tier: https://app.tavily.com
TAVILY_API_KEY=
